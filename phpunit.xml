<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" en <env>: PHPUnit solo escribe en putenv() y $_ENV. Pero el repository
            de Laravel (phpdotenv) lee $_SERVER ANTES que $_ENV, y $_SERVER hereda los valores
            del .env que el proceso padre (php artisan test) ya cargó al bootear el kernel de
            consola. Sin esto, los tests corrían con QUEUE_CONNECTION=redis / MAIL_MAILER=log
            del .env real (los inserts de notificación eran crudos y no lo evidenciaban; ahora
            que la notificación es ShouldQueue, la cola debe ser sync). Los <server> con force
            sobreescriben $_SERVER directamente.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Base de datos de test DEDICADA: los tests corren contra kuestion_test
            (misma instancia MySQL, base separada), NO contra la base de desarrollo
            (kuestion). RefreshDatabase ejecuta migrate:fresh sobre kuestion_test y
            borra/crea solo esa base. Se setean <env> (putenv, lo heredan los procesos
            hijos lanzados con proc_open, p.ej. McpServeCommandTest) y <server>
            (lo lee el repository de Laravel en el proceso actual) con force="true"
            por la misma razon documentada arriba para QUEUE_CONNECTION/MAIL_MAILER.
            La base kuestion_test se crea como parte del setup (mysql -u root -e
            "CREATE DATABASE kuestion_test; GRANT ALL ON kuestion_test.* TO 'kuestion'@'localhost';").
        -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="kuestion_test" force="true"/>
        <server name="DB_DATABASE" value="kuestion_test" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
